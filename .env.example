# ==============================================================================
# WEBTRAVEL SUPABASE CONFIGURATION (ENVIRONMENT VARIABLES)
# ==============================================================================
# Lấy các thông số này trong phần Settings -> API của dự án Supabase của bạn:
# https://supabase.com/dashboard/project/_/settings/api

# 1. Supabase Project URL (vd: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public API Key (anon public key)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
